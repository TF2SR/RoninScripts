resource/ui/menus/srm_speedometer_settings.menu
{
	menu
	{
		ControlName				Frame
		xpos					0
		ypos					0
		zpos					3
		wide					f0
		tall					f0
		autoResize				0
		visible					1
		enabled					1
		pinCorner				0
		PaintBackgroundType		0
		infocus_bgcolor_override	"0 0 0 0"
		outoffocus_bgcolor_override	"0 0 0 0"

        Vignette
        {
            ControlName             ImagePanel
            InheritProperties       MenuVignette
        }

		Title
		{
			ControlName				Label
			InheritProperties		MenuTitle
			labelText				"Speedometer Settings"
		}

		ImgTopBar
		{
			ControlName				ImagePanel
			InheritProperties		MenuTopBar
		}

		MatchmakingStatus
		{
			ControlName				CNestedPanel
			xpos					0
			ypos					0
			wide					f0
			tall					f0
			visible					1
			controlSettingsFile		"resource/ui/menus/panels/matchmaking_status.res"
		}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		LblMenuItemDescription
		{
			ControlName				RuiPanel
			xpos					1275
			ypos					158
			tall					246
			wide 					562
			rui                     "ui/control_options_description.rpak"
		}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		ImgSubheaderBackground
		{
			ControlName				ImagePanel
			InheritProperties		SubheaderBackground
			wide					580
			xpos					96
			ypos					160
		}
		LblSubheaderText
		{
			ControlName				Label
			InheritProperties		SubheaderText
			pin_to_sibling			ImgSubheaderBackground
			pin_corner_to_sibling	LEFT
			pin_to_sibling_corner	LEFT
			labelText				"Display"
		}

		SwchSpeedometerFont
		{
			ControlName				RuiButton
			InheritProperties		SwitchButton
			wide					500
			style					DialogListButton
			ConVar					"srm_speedometer_font"
			list
			{
				"Square"				0
				"Modern"				1
			}
			pin_to_sibling			ImgSubheaderBackground
			pin_corner_to_sibling	TOP_LEFT
			pin_to_sibling_corner	BOTTOM_LEFT
		}

		SwchSpeedometerUnit
		{
			ControlName				RuiButton
			InheritProperties		SwitchButton
			wide					500
			style					DialogListButton
			ConVar					"srm_speedometer_unit"
			list
			{
				"km/h"				0
				"m/s"				1
				"mph"				2
				"Units"				3
				"km/h * 10"			4
			}
			pin_to_sibling			SwchSpeedometerFont
			pin_corner_to_sibling	TOP_LEFT
			pin_to_sibling_corner	BOTTOM_LEFT
		}

		SwchSpeedometerAxisMode
		{
			ControlName				RuiButton
			InheritProperties		SwitchButton
			wide					500
			style					DialogListButton
			ConVar					"srm_speedometer_axismode"
			list
			{
				"XY"		0
				"XYZ"	    1
				"Z"			2
			}
			pin_to_sibling			SwchSpeedometerUnit
			pin_corner_to_sibling	TOP_LEFT
			pin_to_sibling_corner	BOTTOM_LEFT
		}

        SwchSpeedometerAlignment
		{
			ControlName				RuiButton
			InheritProperties		SwitchButton
			wide					500
			style					DialogListButton
